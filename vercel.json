{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ler-prints.js": {
      "maxDuration": 30
    },
    "api/ler-financeiro.js": {
      "maxDuration": 60
    }
  }
}
